---
import { Image } from "astro:assets";

interface Props {
  heroImage: ImageMetadata;
  heroImageAlt: string;
  heroTitle: string;
  heroDescription: string;
  treatmentName: string;
}

const { heroImage, heroImageAlt, heroTitle, heroDescription, treatmentName } =
  Astro.props;
---

<main>
  <section
    class="lg:mt-navbar relative min-h-[70svh] overflow-hidden bg-neutral-900 text-white sm:min-h-[50svh]"
  >
    <Image
      src={heroImage}
      alt={heroImageAlt}
      widths={[768, 1280, 1920, heroImage.width]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-black/25" aria-hidden="true"></div>

    <div
      class="relative z-10 mx-auto flex min-h-[70svh] max-w-7xl items-center justify-center px-6 py-20 text-center sm:min-h-[50svh] lg:px-10"
    >
      <div class="max-w-4xl">
        <fade-in class="text-(length:--step-5)/13 tracking-tighter text-white">
          <h1>{heroTitle}</h1>
        </fade-in>
        <fade-in
          class="mx-auto mt-4 max-w-3xl text-(length:--step-0)/8 text-white"
          delay={0.1}
        >
          <p>{heroDescription}</p>
        </fade-in>
      </div>
    </div>
  </section>

  <section class="mb-16 bg-gray-100 px-6 py-20 md:py-28 lg:px-10">
    <div
      class="max-w-desktop mx-auto grid w-full grid-cols-1 items-center justify-around gap-4 gap-20 md:grid-cols-2"
    >
      <fade-in
        class="text-h3 leading-tight font-[450] text-neutral-600 md:text-center"
      >
        <h2>{treatmentName}</h2>
      </fade-in>

      <fade-in
        class="text-ne max-w-[80ch] space-y-8 text-left text-(length:--step-0)/8 text-balance"
        delay={0.1}
      >
        <slot />
      </fade-in>
    </div>
  </section>

  <slot name="sections" />
</main>
