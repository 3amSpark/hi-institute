---
const navLinks = [
  { href: "/", label: "Inicio" },
  { label: "Tratamientos" },
  { href: "/farmacia", label: "Farmacia" },
  { label: "Clínicas" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/contacto", label: "Contacto" },
];

const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=The%20Health%20Institute%20Centro%20de%20Fertilidad%20y%20Peso%20en%20Guatemala%2C%20Avenida%20La%20Reforma%209-55%2C%20Cdad.%20de%20Guatemala%2001010";
const mapsEmbedUrl =
  "https://www.google.com/maps?q=The%20Health%20Institute%20Centro%20de%20Fertilidad%20y%20Peso%20en%20Guatemala%2C%20Avenida%20La%20Reforma%209-55%2C%20Cdad.%20de%20Guatemala%2001010&z=16&output=embed";
const currentYear = new Date().getFullYear();
---

<footer class="overflow-hidden">
  <section
    class="bg-brand-blue flex min-h-96 flex-col items-center justify-center border-t border-neutral-200 text-center"
  >
    <fade-in class="text-h3 leading-12 font-medium text-white">
      <h3>
        Tu cuerpo te está hablando.<br />
        <span class="text-h2"> Es momento de escucharlo. </span>
      </h3>
    </fade-in>
    <a
      href="/contacto"
      class="btn-depth mt-8 w-fit rounded-full [--depth-color:#fff] px-6 py-2 text-base tracking-wide uppercase transition-[filter] hover:brightness-95"
    >
      ¡Agenda tu cita hoy!
    </a>
  </section>

  <section
    class="bg-brand-green flex max-h-svh flex-col items-center justify-between text-center text-white md:flex-row"
  >
    <fade-in
      class="flex-1 py-20 text-(length:--step-4) leading-tight font-medium tracking-tighter text-balance"
    >
      <h2>
        Estamos más cerca<br />
        de lo que crees.
      </h2>
    </fade-in>

    <iframe
      src={mapsEmbedUrl}
      title="HI Institute en Avenida La Reforma 9-55, Ciudad de Guatemala"
      class="h-160 w-full shrink-0 md:flex-2"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>

  <section class="bg-neutral-700 py-14 md:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div
        class="grid gap-8 border-b border-white/20 pb-14 md:grid-cols-[minmax(0,0.8fr)_minmax(24rem,1.2fr)] md:items-end md:gap-16 md:pb-16"
      >
        <div>
          <h2
            class="text-(length:--step-3) leading-tight font-medium tracking-tight text-white"
          >
            Mantente al día
          </h2>
          <p
            id="newsletter-description"
            class="mt-2 max-w-lg text-(length:--step-0)/7 text-white/80"
          >
            Recibe consejos de salud, nuevos tratamientos y novedades de HI
            Institute directamente en tu correo.
          </p>
        </div>

        <form
          action="https://hiinsitute.us19.list-manage.com/subscribe/post?u=0fb5590dd50788770783c1cb4&amp;id=bf8507dcf1&amp;f_id=00aa7ce7f0"
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          target="_self"
          aria-describedby="newsletter-description"
          class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]"
        >
          <label class="sr-only" for="footer-email">Correo electrónico</label>
          <input
            id="footer-email"
            type="email"
            name="EMAIL"
            placeholder="Tu correo electrónico"
            autocomplete="email"
            inputmode="email"
            required
            class="h-14 min-w-0 rounded-full border border-white/30 bg-white px-6 text-base text-neutral-800 outline-none transition-[border-color,box-shadow] placeholder:text-neutral-400 focus:border-brand-blue focus:ring-3 focus:ring-brand-blue/30"
          />

          <div aria-hidden="true" class="absolute -left-[5000px]">
            <input
              type="text"
              name="b_0fb5590dd50788770783c1cb4_bf8507dcf1"
              tabindex="-1"
              autocomplete="off"
              value=""
            />
          </div>

          <button
            type="submit"
            name="subscribe"
            id="mc-embedded-subscribe"
            class="btn-depth h-14 rounded-full [--depth-color:var(--color-brand-blue)] px-7 text-base font-medium text-white transition-[filter] hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
          >
            Suscribirme
          </button>
        </form>
      </div>

      <div
        class="mt-14 grid gap-12 md:grid-cols-[auto_1fr] md:items-start md:gap-24"
      >
        <a href="/" aria-label="HI Institute International home">
          <img
            src="/assets/logos/brand/logo-white.svg"
            alt="HI Health Institute International"
            class="h-auto w-54 max-w-full"
            loading="lazy"
          />
        </a>

        <nav
          aria-label="Footer navigation"
          class="grid gap-x-8 gap-y-6 sm:grid-cols-2 md:justify-self-end lg:grid-cols-3"
        >
          {
            navLinks.map((link) =>
              link.href ? (
                <a
                  href={link.href}
                  class="text-(length:--step--1) font-medium text-white transition-opacity hover:opacity-75"
                >
                  {link.label}
                </a>
              ) : (
                <span class="text-(length:--step--1) font-medium text-white/80">
                  {link.label}
                </span>
              ),
            )
          }
        </nav>
      </div>

      <p
        class="mt-12 text-center text-(length:--step--1)/7 font-medium text-white/80 md:mt-16"
      >
        HI Institute · Health Institute International forma parte de A Tu
        Origen, Sociedad Anónima. © {currentYear}. Todos los derechos reservados
      </p>
    </div>
  </section>
</footer>
