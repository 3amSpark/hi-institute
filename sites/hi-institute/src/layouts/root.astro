---
import GlassixWidget from "../components/glassix-widget.astro";
import NewsletterPopup from "../components/newsletter-popup.astro";
import defaultSocialImage from "../assets/images/home/hero/metabolism.webp";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "HI Institute",
  description = "Clínica especializada en metabolismo, balance hormonal, salud femenina y fertilidad en Ciudad de Guatemala.",
} = Astro.props;

const isRootPage = Astro.url.pathname === "/";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const siteUrl = new URL("/", Astro.site ?? Astro.url.origin);
const clinicId = new URL("/#clinic", siteUrl);
const socialImageUrl = new URL(
  defaultSocialImage.src,
  siteUrl,
);
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=The%20Health%20Institute%20Centro%20de%20Fertilidad%20y%20Peso%20en%20Guatemala%2C%20Avenida%20La%20Reforma%209-55%2C%20Cdad.%20de%20Guatemala%2001010";
const websiteStructuredData = {
  "@type": "WebSite",
  "@id": new URL("/#website", siteUrl).href,
  url: siteUrl.href,
  name: "HI Institute",
  alternateName: "Health Institute International",
  inLanguage: "es-GT",
  publisher: {
    "@id": clinicId.href,
  },
};
const clinicStructuredData = {
  "@type": "MedicalClinic",
  "@id": clinicId.href,
  name: "HI Institute",
  alternateName: "Health Institute International",
  url: siteUrl.href,
  logo: new URL("/assets/logos/brand/logo.svg", siteUrl).href,
  image: socialImageUrl.href,
  telephone: "+502 3015 6931",
  hasMap: mapsUrl,
  areaServed: {
    "@type": "Country",
    name: "Guatemala",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avenida La Reforma 9-55, Zona 10",
    addressLocality: "Ciudad de Guatemala",
    addressRegion: "Guatemala",
    postalCode: "01010",
    addressCountry: "GT",
  },
  sameAs: [
    "https://www.instagram.com/healthinstitute_int/",
    "https://www.facebook.com/HealthInstituteInt/",
  ],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    ...(isRootPage ? [websiteStructuredData] : []),
    clinicStructuredData,
  ],
};
---

<!doctype html>
<html lang="es-GT">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1d75b8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:site_name" content="HI Institute" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="HI Institute en Ciudad de Guatemala" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/assets/icons/favicons/favicon.svg"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&display=swap"
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/png"
      href="/assets/icons/favicons/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="shortcut icon" href="/assets/icons/favicons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/icons/favicons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="HI Institute" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!--
      <fade-in> custom element. Inlined so it registers before first paint
      (no flash of visible-then-hidden content). The hidden state in
      global.css is gated on `fade-in:defined`, so if JS never runs the
      content stays visible.
    -->
    <script is:inline>
      (() => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute("data-visible", "");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.25 },
        );

        customElements.define(
          "fade-in",
          class extends HTMLElement {
            connectedCallback() {
              const activate = () => {
                if (!this.isConnected) return;

                const delay = matchMedia("(min-width: 1024px)").matches
                  ? this.getAttribute("delay")
                  : (this.getAttribute("mobile-delay") ??
                    this.getAttribute("delay"));

                if (delay)
                  this.style.setProperty("--fade-in-delay", `${delay}s`);

                if (this.hasAttribute("instant")) {
                  // Above-the-fold content: reveal on load instead of on
                  // scroll. Double rAF lets the hidden state paint first so
                  // the transition still runs.
                  requestAnimationFrame(() =>
                    requestAnimationFrame(() =>
                      this.setAttribute("data-visible", ""),
                    ),
                  );
                } else {
                  observer.observe(this);
                }
              };

              // React must hydrate against the unchanged server HTML. Astro
              // emits this event once an island has finished hydrating, so
              // delay attribute and style mutations for fade-ins inside it.
              const island = this.closest("astro-island[ssr]");
              if (island) {
                island.addEventListener("astro:hydrate", activate, {
                  once: true,
                });
              } else {
                activate();
              }
            }

            disconnectedCallback() {
              observer.unobserve(this);
            }
          },
        );
      })();
    </script>
  </head>
  <body class="font-grotesk text-neutral-800">
    {
      isRootPage && (
        <>
          {/*
            Homepage intro curtain. The inline script activates it before the
            div below is parsed, so there is never a flash of content first.
            Shown on every visit for users who allow motion; if JS fails the
            curtain stays display:none and content is visible.
          */}
          <script is:inline>
            try {
              if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
                document.documentElement.setAttribute("data-curtain", "");
              }
            } catch (_) {}
          </script>
          <div id="page-curtain" aria-hidden="true">
            <img
              src="/assets/logos/brand/logo-white.svg"
              alt=""
              width="164"
              height="48"
            />
          </div>
          <script is:inline>
            document
              .getElementById("page-curtain")
              .addEventListener("animationend", (event) => {
                if (event.target === event.currentTarget)
                  event.currentTarget.remove();
              });
          </script>
        </>
      )
    }
    <div id="site-canvas">
      <slot />
    </div>
    <NewsletterPopup />
    <GlassixWidget />
  </body>
</html>
