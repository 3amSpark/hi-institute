---
import Navbar from "../components/navbar.astro";
import Root from "../layouts/root.astro";

const whatsappUrl =
  "https://wa.me/50230156931?text=%C2%A1Hola!%20Estoy%20interesada(o)%20en%20agendar%20una%20evaluaci%C3%B3n%20metab%C3%B3lica%20y%20hormonal";
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=The%20Health%20Institute%20Centro%20de%20Fertilidad%20y%20Peso%20en%20Guatemala%2C%20Avenida%20La%20Reforma%209-55%2C%20Cdad.%20de%20Guatemala%2001010";

const socialLinks = [
  {
    href: "https://www.instagram.com/healthinstitute_int/",
    label: "Instagram",
  },
  {
    href: "https://www.facebook.com/HealthInstituteInt/",
    label: "Facebook",
  },
];
---

<Root
  title="Contacto y Citas en Guatemala | HI Institute"
  description="Contacta a HI Institute en Ciudad de Guatemala y agenda tu evaluación metabólica y hormonal por WhatsApp o teléfono."
>
  <Navbar />

  <main class="bg-neutral-100">
    <section class="grid min-h-svh lg:grid-cols-2">
      <div
        class="flex flex-col items-center justify-center bg-linear-to-br from-neutral-200/70 via-neutral-100 to-white px-4 py-16 text-center sm:px-6 lg:px-10"
      >
        <div class="mx-auto max-w-3xl">
          <fade-in
            class="text-(length:--step-4)/[1.02] font-[550] tracking-tighter text-balance text-neutral-800 md:text-(length:--step-5)/[0.98]"
          >
            <h1>Empecemos por entender qué necesita tu cuerpo.</h1>
          </fade-in>
        </div>
      </div>

      <div
        class="bg-brand-blue relative flex flex-col justify-center px-4 py-20 text-white sm:px-6 lg:px-10"
      >
        <div class="mx-auto w-full max-w-xl">
          <fade-in
            class="max-w-xl text-(length:--step-4)/[1.02] font-[550] tracking-tighter text-balance md:text-(length:--step-5)/[0.98]"
          >
            <h2>Hablemos por WhatsApp.</h2>
          </fade-in>
          <fade-in
            delay={0.1}
            class="mt-6 max-w-lg text-base leading-relaxed text-white/85 md:text-(length:--step-0)/8"
          >
            <p>
              Te responderemos para conocer tu caso y ayudarte a elegir el
              mejor punto de partida.
            </p>
          </fade-in>
          <fade-in delay={0.2} class="mt-10">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noreferrer"
              class="btn-depth group inline-flex items-center gap-4 rounded-full [--depth-color:#fff] py-2 pr-2 pl-5 text-sm font-semibold text-neutral-800 transition-[filter] hover:brightness-95"
            >
              <span>Escríbenos ahora</span>
              <span
                class="grid size-8 place-items-center rounded-full bg-neutral-800 text-white"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                  <path d="m13 6 6 6-6 6"></path>
                </svg>
              </span>
            </a>

            <div class="mt-6 flex items-center gap-4">
              {
                socialLinks.map((link) => (
                  <a
                    href={link.href}
                    aria-label={link.label}
                    target="_blank"
                    rel="noreferrer"
                    class="text-white transition-opacity hover:opacity-70"
                  >
                    {link.label === "Instagram" ? (
                      <svg
                        class="size-9"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="5" />
                        <circle cx="12" cy="12" r="4" />
                        <circle
                          cx="17.5"
                          cy="6.5"
                          r="1"
                          fill="currentColor"
                          stroke="none"
                        />
                      </svg>
                    ) : (
                      <svg
                        class="size-9"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2V8.6H15.2c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06Z" />
                      </svg>
                    )}
                  </a>
                ))
              }
              <a
                href="tel:+50230156931"
                class="text-sm font-medium text-white/80 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
              >
                +502 3015 6931
              </a>
            </div>
            <address class="mt-5 text-sm leading-relaxed text-white/80 not-italic">
              <a
                href={mapsUrl}
                target="_blank"
                rel="noreferrer"
                class="underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
              >
                Avenida La Reforma 9-55, Zona 10<br />
                Ciudad de Guatemala, Guatemala 01010
              </a>
            </address>
          </fade-in>
        </div>
      </div>
    </section>
  </main>
</Root>
