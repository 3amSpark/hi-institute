---
import {
  buildWhatsAppUrl,
  WHATSAPP_CONTACT_ENABLED,
} from "../constants";

interface Props {
  text: string;
  topic?: string;
  href?: string;
  class?: string;
  variant?: "primary" | "secondary";
  target?: "_blank" | "_self" | "_parent" | "_top";
  leadCtaLocation?: "hero" | "final_cta" | "footer";
}
const {
  text,
  topic,
  href: customHref,
  variant = "primary",
  class: className,
  target = "_blank",
  leadCtaLocation,
} = Astro.props as Props;
const href = WHATSAPP_CONTACT_ENABLED
  ? (customHref ?? buildWhatsAppUrl(topic))
  : undefined;
---

<a
  href={href}
  target={WHATSAPP_CONTACT_ENABLED ? target : undefined}
  rel={WHATSAPP_CONTACT_ENABLED ? "noopener noreferrer" : undefined}
  aria-disabled={WHATSAPP_CONTACT_ENABLED ? undefined : "true"}
  tabindex={WHATSAPP_CONTACT_ENABLED ? undefined : -1}
  data-ga-lead-cta={
    WHATSAPP_CONTACT_ENABLED ? leadCtaLocation : undefined
  }
  class:list={[
    "font-heading group highlight relative inline-block w-fit overflow-hidden rounded-full px-7 py-2 text-lg font-medium",
    WHATSAPP_CONTACT_ENABLED ? "cursor-pointer" : "pointer-events-none",
    variant == "primary" ? "bg-brand text-white" : "text-initia-blue bg-white",
    className,
  ]}
>
  <span class="invisible">{text}</span>
  <span
    class="absolute inset-0 flex -translate-y-full items-center justify-center font-medium transition-transform duration-300 group-hover:translate-y-0"
  >
    {text}
  </span>
  <span
    class="absolute inset-0 flex translate-y-0 items-center justify-center font-medium transition-transform duration-300 group-hover:translate-y-full"
  >
    {text}
  </span>
</a>
